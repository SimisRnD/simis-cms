<services>
  <service method="post" endpoint="session" class="com.simisinc.platform.rest.services.session.SessionService" />
  <!--<service endpoint="register" class="com.simisinc.platform.presentation.rest.register.RegisterService" />-->
  <service method="get" endpoint="me" class="com.simisinc.platform.rest.services.userProfile.MeService" />
  <!-- ContentService also implements post(), for POST /content/{contentUniqueId} (issue #412 PR2).
       Not listed as its own <service method="post" .../> row: RestServlet dispatches purely by
       reflecting for a method named after the HTTP verb on whichever class this endpoint maps to,
       so the "method" attribute here is informational only, not read by the dispatcher. Keep this
       comment free of a doubled hyphen; see PR #939 for why that already broke this exact file
       once. -->
  <service method="get" endpoint="content/{contentUniqueId}" class="com.simisinc.platform.rest.services.cms.ContentService" />
  <!-- MailingListMemberService implements post() and put(), for POST /mailing-list-members (create)
       and PUT /mailing-list-members/{memberId} (update) (issue #412 PR3). One row covers both verbs
       and both the param-less collection endpoint and the param'd item endpoint: RestServlet falls
       back from a direct "mailing-list-members" lookup miss to splitting off a trailing path param,
       so POST resolves via the direct hit and PUT via the fallback split. See the comment on the
       POST-capable content entry above for why the method attribute here is informational only. -->
  <service method="post, put" endpoint="mailing-list-members/{memberId}" class="com.simisinc.platform.rest.services.mailinglists.MailingListMemberService" />
  <service method="get" endpoint="collections" class="com.simisinc.platform.rest.services.items.CollectionListService" />
  <service method="get" endpoint="categories/{collectionUniqueId}" class="com.simisinc.platform.rest.services.items.CategoryListService" />
  <service method="get" endpoint="items/{collectionUniqueId}?category=${categoryUniqueId}&amp;query=value" class="com.simisinc.platform.rest.services.items.ItemListService" />
  <service method="get" endpoint="item/{itemUniqueId}" class="com.simisinc.platform.rest.services.items.ItemService" />
  <!--
  audit-log?category=&eventType=&outcome=&actor=&sourceIp=&targetType=&targetLabel=&range=&fromDate=&toDate=&page=&size=
  NOTE: XMLServiceLoader only strips a query string when it follows a "/{pathParam}" segment (see
  addServices()); a plain endpoint like this one must NOT have "?..." appended to the endpoint
  attribute itself, or the literal query string becomes part of the registered lookup key and the
  route silently 404s. Keep this comment free of two consecutive hyphens: that sequence inside an
  XML comment fails Tomcat's strict parser at deploy time, same landmine as PR #178's context.xml
  incident.
  -->
  <service method="get" endpoint="audit-log" class="com.simisinc.platform.rest.services.audit.AuditLogListService" />
  <!--
  Issue #412: read endpoints for web pages, blog posts, and folder files. "blog-posts/{id}" and
  "post/{blogId}/{postId}" deviate from the issue's originally-specced "blog/{id}/posts" and
  "post/{postId}" - RestServlet's router only supports up to 2 raw path params with no literal
  segment between them, and BlogPostRepository.findByUniqueId is keyed by (blogId, postUniqueId),
  not a globally-unique post id. See each service class's javadoc for the full rationale.
  -->
  <service method="get" endpoint="pages" class="com.simisinc.platform.rest.services.cms.PagesListService" />
  <service method="get" endpoint="page/{pagePath}" class="com.simisinc.platform.rest.services.cms.PageService" />
  <service method="get" endpoint="blog-posts/{blogUniqueId}" class="com.simisinc.platform.rest.services.cms.BlogPostListService" />
  <service method="get" endpoint="post/{blogUniqueId}/{postUniqueId}" class="com.simisinc.platform.rest.services.cms.BlogPostService" />
  <service method="get" endpoint="files/{folderUniqueId}" class="com.simisinc.platform.rest.services.cms.FolderFilesListService" />
  <service method="get" endpoint="file/{fileId}" class="com.simisinc.platform.rest.services.cms.FileService" />
  <!--
  /item-blog/unique-id
  /item-blog-post/unique-id/post-id
  /item-gallery/unique-id
  /item-events/unique-id
  /item-event/unique-id/event-id
  /item-lists/unique-id
  /item-list/unique-id/list-id
  /item-list-entry/unique-id/entry-id
  -->
</services>
