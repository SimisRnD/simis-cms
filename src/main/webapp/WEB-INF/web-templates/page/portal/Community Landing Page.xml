<template name="Community Landing Page">
  <rules>
    <collection uniqueId="groups" name="Groups" />
  </rules>
  <page>
    <!-- The <rules> block above is not currently processed anywhere (see issue #1287); it
         does not actually create the "groups" collection. Until that's built, create a
         collection named "Groups" (unique ID "groups") manually via /admin/collections
         before this page's Add-a-Group button and list will work. -->
    <section>
      <column class="small-12 cell">
        <widget name="content">
          <uniqueId>community-title</uniqueId>
          <html><![CDATA[<h3>Welcome to the Community!</h3>]]></html>
        </widget>
        <widget name="itemsList">
          <title>Explore our collaboration groups...</title>
          <showWhenEmpty>true</showWhenEmpty>
          <collectionUniqueId>groups</collectionUniqueId>
        </widget>
        <widget name="addItemButton">
          <buttonName>Add a Group</buttonName>
          <collectionUniqueId>groups</collectionUniqueId>
        </widget>
      </column>
    </section>
  </page>
</template>
