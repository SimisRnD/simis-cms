<template name="Content with News Sidebar" image="Content with News Sidebar.png" priority="3">
  <page>
    <!-- Main content with a right rail showing the latest posts from a blog as a compact panel
         (blogPostList view=panel, issue #1216). The rail points at a blog with uniqueId "news":
         create it in Admin > Blogs, or change blogUniqueId below to your news/announcements blog. -->
    <section>
      <column class="small-12 medium-8 cell">
        <widget name="content">
          <uniqueId>${webPageName}-content</uniqueId>
        </widget>
      </column>
      <column class="small-12 medium-4 cell">
        <widget name="blogPostList" class="callout secondary" sticky="true">
          <title>Latest News</title>
          <blogUniqueId>news</blogUniqueId>
          <view>panel</view>
          <limit>5</limit>
          <viewAllUrl>/news</viewAllUrl>
          <viewAllText>View all news</viewAllText>
        </widget>
      </column>
    </section>
  </page>
</template>
