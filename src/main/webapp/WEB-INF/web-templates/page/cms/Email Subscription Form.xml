<template name="Email Subscription Form" image="Email Subscription Form.png">
  <page>
    <!-- Uses the "Newsletter" mailing list seeded at install. To point this at a different list, open Admin/Mailing Lists, copy that list's Unique Id, and put it in the mailingListUniqueId preference below -->
    <section class="align-center">
      <column class="small-12 medium-8 cell">
        <widget name="content">
          <uniqueId>${webPageName}-content</uniqueId>
        </widget>
        <widget name="emailSubscribe">
          <!-- A mailing list with this unique id must exist (Admin/Mailing Lists shows each list's Unique Id) or this widget will not render. Unlike a list's name, its unique id is fixed when the list is created and survives a rename. The older mailingList preference, which names a list instead, is still supported -->
          <mailingListUniqueId>newsletter</mailingListUniqueId>
          <title>Subscribe to our mailing list</title>
          <buttonName>Subscribe</buttonName>
          <successMessage>You are now subscribed!</successMessage>
        </widget>
      </column>
    </section>
  </page>
</template>
