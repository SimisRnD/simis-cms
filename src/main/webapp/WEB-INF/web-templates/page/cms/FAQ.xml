<template name="FAQ" image="FAQ.png">
  <page>
    <section class="align-center">
      <column class="small-12 medium-10 large-7 cell">
        <widget name="content" class="margin-top-75 margin-bottom-25 small-margin-25">
          <uniqueId>${webPageName}-title</uniqueId>
        </widget>
        <widget name="content">
          <uniqueId>${webPageName}-hello</uniqueId>
        </widget>
        <widget name="faq" class="margin-top-50">
          <title>Frequently Asked Questions</title>
          <questions>
            <entry question="How do I know which product is right for me?"
                answer="Our products are designed to meet your specific needs and fit into your lifestyle." />
            <entry question="How do I use the product?"
                answer="You can follow the directions included with your order." />
            <entry question="How do I request support for a service?"
                answer="Reach out through our contact page and a team member will follow up." />
          </questions>
        </widget>
        <widget name="content" class="margin-top-50 callout no-box light">
          <uniqueId>${webPageName}-more</uniqueId>
        </widget>
      </column>
    </section>
  </page>
</template>
