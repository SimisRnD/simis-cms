<template name="Home Page With Scrolling Banner" image="Home Page With Scrolling Banner.png">
  <page class="full-page">
    <section class="row align-center expanded platform-no-margin">
      <column class="none">
        <widget name="contentSlider">
          <smallCardCount>1</smallCardCount>
          <showControls>false</showControls>
          <showPagination>true</showPagination>
          <loop>false</loop>
          <autoplayDelay>5000</autoplayDelay>
          <html><![CDATA[
<figure class="orbit-figure">
  <img class="orbit-image" src="${ctx}/images/sample/1st.png" alt="Placeholder banner image -- replace with your own photo">
  <figcaption class="orbit-caption">
    <h3>Welcome!</h3>
    <p>This is your home page banner. Replace this image and text to introduce your site, then use the button below to link to a page of your own.</p>
    <a href="${ctx}/" class="button yellow">Sample Link</a>
  </figcaption>
</figure>
<hr />
<figure class="orbit-figure">
  <img class="orbit-image" src="${ctx}/images/sample/2nd.png" alt="Placeholder banner image -- replace with your own photo">
  <figcaption class="orbit-caption">
    <h3>Second Highlight</h3>
    <p>Each slide can call out something different -- a service, an announcement, or a featured page. Replace this text with your own.</p>
    <a href="${ctx}/" class="button yellow">Sample Link</a>
  </figcaption>
</figure>
<hr />
<figure class="orbit-figure">
  <img class="orbit-image" src="${ctx}/images/sample/3rd.png" alt="Placeholder banner image -- replace with your own photo">
  <figcaption class="orbit-caption">
    <h3>Third Highlight</h3>
    <p>A third slide for one more highlight. Delete this slide, or the whole banner, if your site doesn't need one.</p>
    <a href="${ctx}/" class="button yellow">Sample Link</a>
  </figcaption>
</figure>
    ]]></html>
        </widget>
      </column>
    </section>
    <section>
      <!-- Four feature callouts, left blank on purpose: an editor sees an "Add Content Here"
           prompt for each; a visitor sees nothing until they're filled in. -->
      <column class="small-6 medium-3 text-center cell">
        <widget name="content">
          <uniqueId>${webPageName}-feature-1</uniqueId>
        </widget>
      </column>
      <column class="small-6 medium-3 text-center cell">
        <widget name="content">
          <uniqueId>${webPageName}-feature-2</uniqueId>
        </widget>
      </column>
      <column class="small-6 medium-3 text-center cell">
        <widget name="content">
          <uniqueId>${webPageName}-feature-3</uniqueId>
        </widget>
      </column>
      <column class="small-6 medium-3 text-center cell">
        <widget name="content">
          <uniqueId>${webPageName}-feature-4</uniqueId>
        </widget>
      </column>
    </section>
    <section hr="true">
      <column class="small-12 cell">
        <widget name="content">
          <uniqueId>${webPageName}-title</uniqueId>
        </widget>
      </column>
    </section>
    <section>
      <column class="medium-7 large-6 cell">
        <widget name="content">
          <uniqueId>${webPageName}-image</uniqueId>
        </widget>
      </column>
      <column class="show-for-large large-3 cell">
        <widget name="content">
          <uniqueId>${webPageName}-callout-1</uniqueId>
        </widget>
      </column>
      <column class="medium-5 large-3 cell">
        <widget name="content" class="callout primary">
          <uniqueId>${webPageName}-callout-2</uniqueId>
        </widget>
      </column>
    </section>
    <section hr="true">
      <column class="small-12 text-center cell">
        <widget name="content">
          <uniqueId>${webPageName}-welcome</uniqueId>
        </widget>
      </column>
    </section>
  </page>
</template>
