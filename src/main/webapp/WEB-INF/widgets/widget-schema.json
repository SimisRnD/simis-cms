{
  "version": "1.0",
  "description": "Machine-readable preferences schema for Visual Editor palette widgets. Field names match the Java widget getPreferences() keys exactly.",
  "widgets": {

    "content": {
      "label": "Content",
      "category": "Content",
      "icon": "fa-align-left",
      "preferences": [
        {"name": "uniqueId",          "label": "Content Unique ID", "type": "text"},
        {"name": "html",              "label": "Inline HTML",        "type": "html"},
        {"name": "title",             "label": "Section Title",      "type": "text"},
        {"name": "icon",              "label": "Icon (FA class)",    "type": "text"},
        {"name": "videoBackgroundUrl","label": "Video Background URL","type": "url"}
      ]
    },

    "contentAccordion": {
      "label": "Accordion",
      "category": "Content",
      "icon": "fa-list",
      "preferences": [
        {"name": "uniqueId", "label": "Content Unique ID", "type": "text"},
        {"name": "html",     "label": "Inline HTML",       "type": "html"}
      ]
    },

    "contentSlider": {
      "label": "Content Slider",
      "category": "Content",
      "icon": "fa-images",
      "preferences": [
        {"name": "uniqueId",     "label": "Content Unique ID",   "type": "text"},
        {"name": "html",         "label": "Inline HTML",          "type": "html"},
        {"name": "showControls", "label": "Show Controls",        "type": "boolean", "default": "true"},
        {"name": "showPagination","label": "Show Pagination",     "type": "boolean", "default": "true"},
        {"name": "loop",         "label": "Loop",                 "type": "boolean", "default": "true"},
        {"name": "autoplayDelay","label": "Autoplay Delay (ms, -1=off)", "type": "number", "default": "-1"},
        {"name": "carouselClass","label": "Carousel CSS Class",   "type": "text"},
        {"name": "cardClass",    "label": "Card CSS Class",       "type": "text"}
      ]
    },

    "contentGallery": {
      "label": "Content Gallery",
      "category": "Content",
      "icon": "fa-th",
      "preferences": [
        {"name": "uniqueId", "label": "Content Unique ID", "type": "text"},
        {"name": "html",     "label": "Inline HTML",       "type": "html"}
      ]
    },

    "contentReveal": {
      "label": "Content Reveal",
      "category": "Content",
      "icon": "fa-window-restore",
      "preferences": [
        {"name": "uniqueId",   "label": "Content Unique ID", "type": "text"},
        {"name": "html",       "label": "Inline HTML",       "type": "html"},
        {"name": "attach",     "label": "Attach Position",   "type": "select", "options": ["left", "right", "top", "bottom"], "default": "left"},
        {"name": "animate",    "label": "Animation",         "type": "select", "options": ["up", "down", "left", "right", "fade"]},
        {"name": "revealClass","label": "Reveal CSS Class",  "type": "text"},
        {"name": "useIcon",    "label": "Use Icon Button",   "type": "boolean", "default": "false"}
      ]
    },

    "faq": {
      "label": "FAQ",
