          "items": [
            {"name": "name",            "label": "Tab Name",       "type": "text"},
            {"name": "linkId",          "label": "Link ID",        "type": "text"},
            {"name": "link",            "label": "Link URL",       "type": "url"},
            {"name": "contentUniqueId", "label": "Content Unique ID", "type": "text"},
            {"name": "isActive",        "label": "Active",         "type": "boolean"}
