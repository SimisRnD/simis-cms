<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee
         https://jakarta.ee/xml/ns/jakartaee/web-app_6_1.xsd"
         version="6.1">
  <display-name>App Platform</display-name>
  <!-- Context Params -->
  <!-- Give JSTL a formatting locale to fall back on, so <fmt:formatDate> formats for every client
       rather than only for those that send an Accept-Language header (issue #1385).

       JSTL does not honour the Servlet spec's "no Accept-Language means use the server's default
       locale" rule. Util.getRequestLocales() returns an EMPTY enumeration when the header is
       absent, rather than the container's default:

         Enumeration values = request.getHeaders("accept-language");
         if (values.hasMoreElements()) { return request.getLocales(); } else { return values; }

       findFormattingMatch() then iterates nothing, getFormattingLocale() returns null, and
       FormatDateSupport prints the raw value: a java.sql.Timestamp renders as
       "2026-09-17 04:00:00.0" where the JSP asked for "MMMM d, yyyy". The tag never fails, so
       nothing surfaces in the logs. Browsers always send the header and so mostly look correct;
       crawlers generally do not, which is why the indexed render is the broken one and manual
       spot-checks pass. This is the only remaining escape hatch on that path: no value of
       -Duser.language, LANG or LC_ALL can reach it, because Locale.getDefault() is never consulted.

       fallbackLocale, NOT locale: fmt.locale forces a locale on every request and would override a
       real browser preference, so a fr-FR visitor would start getting English dates. fallbackLocale
       applies only when matching produced nothing, leaving genuine client locales intact. Verified
       against tomcat:11.0-jdk21 with the vendored Glassfish JSTL 3.0.1: with no header the date
       formats as "September 17, 2026", and an fr-FR request still yields "septembre 17, 2026". -->
  <context-param>
    <param-name>jakarta.servlet.jsp.jstl.fmt.fallbackLocale</param-name>
    <param-value>en_US</param-value>
  </context-param>
  <!--<context-param>-->
    <!--<param-name>resteasy.servlet.mapping.prefix</param-name>-->
    <!--<param-value>/api</param-value>-->
  <!--</context-param>-->
  <!-- Listeners -->
  <listener>
    <listener-class>com.simisinc.platform.presentation.controller.ContextListener</listener-class>
  </listener>
  <!--<listener>-->
    <!--<listener-class>com.simisinc.platform.presentation.controller.SessionListener</listener-class>-->
  <!--</listener>-->
  <!-- Filters -->
  <!-- Mapped before everything else so it wraps the whole chain: an uncaught exception from any
       filter, servlet, or JSP forward below it is recorded before the container's own error-page
       handling takes over (issue #556). -->
  <filter>
    <filter-name>ServiceErrorLoggingFilter</filter-name>
    <filter-class>com.simisinc.platform.presentation.controller.ServiceErrorLoggingFilter</filter-class>
  </filter>
  <!-- Compresses generated responses. Mapped just inside ServiceErrorLoggingFilter, so that
       filter still wraps the whole chain and keeps the exception-logging guarantee from #556,
       while this one still wraps every page PageServlet renders. -->
  <filter>
    <filter-name>ResponseCompressionFilter</filter-name>
    <filter-class>com.simisinc.platform.presentation.controller.ResponseCompressionFilter</filter-class>
  </filter>
  <!-- Opt-in: when CMS_TRUSTED_PROXIES is set, resolve the real client IP from
       X-Forwarded-For before any IP-based control runs. Must be mapped first. -->
  <filter>
    <filter-name>TrustedProxyIpFilter</filter-name>
    <filter-class>com.simisinc.platform.presentation.controller.TrustedProxyIpFilter</filter-class>
  </filter>
  <filter>
    <filter-name>WebRequestFilter</filter-name>
    <filter-class>com.simisinc.platform.presentation.controller.WebRequestFilter</filter-class>
  </filter>
  <filter>
    <filter-name>RestRequestFilter</filter-name>
    <filter-class>com.simisinc.platform.rest.controller.RestRequestFilter</filter-class>
  </filter>
  <filter-mapping>
    <filter-name>ServiceErrorLoggingFilter</filter-name>
    <url-pattern>/*</url-pattern>
  </filter-mapping>
  <filter-mapping>
    <filter-name>ResponseCompressionFilter</filter-name>
    <url-pattern>/*</url-pattern>
  </filter-mapping>
  <filter-mapping>
    <filter-name>TrustedProxyIpFilter</filter-name>
    <url-pattern>/*</url-pattern>
  </filter-mapping>
  <filter-mapping>
    <filter-name>WebRequestFilter</filter-name>
    <url-pattern>/*</url-pattern>
  </filter-mapping>
  <filter-mapping>
    <filter-name>RestRequestFilter</filter-name>
    <url-pattern>/api</url-pattern>
    <url-pattern>/api/*</url-pattern>
  </filter-mapping>
  <servlet>
    <servlet-name>PageServlet</servlet-name>
    <servlet-class>com.simisinc.platform.presentation.controller.PageServlet</servlet-class>
    <load-on-startup>1</load-on-startup>
  </servlet>
  <servlet>
    <servlet-name>RestServlet</servlet-name>
    <servlet-class>com.simisinc.platform.rest.controller.RestServlet</servlet-class>
    <load-on-startup>1</load-on-startup>
  </servlet>
  <servlet>
    <servlet-name>MediaApi</servlet-name>
    <servlet-class>com.simisinc.platform.presentation.controller.MediaApiController</servlet-class>
  </servlet>
  <servlet>
    <servlet-name>StylesheetServlet</servlet-name>
    <servlet-class>com.simisinc.platform.presentation.controller.StylesheetServlet</servlet-class>
    <load-on-startup>1</load-on-startup>
  </servlet>
  <servlet>
    <servlet-name>RobotsServlet</servlet-name>
    <servlet-class>com.simisinc.platform.presentation.controller.RobotsServlet</servlet-class>
  </servlet>
  <!-- Mappings -->
  <servlet-mapping>
    <servlet-name>default</servlet-name>
    <!-- The path every browser asks for on its own, whether or not the page declares a
         rel="icon" link. PageServlet is mapped to "/" and so answers anything unmapped, which
         made this render a 404 page for an icon this application already ships. An exact-match
         pattern, not the "/favicon.*" that used to sit here commented out: the servlet spec knows
         only exact paths, "/prefix/*" and "*.ext", so "/favicon.*" was never a wildcard. It would
         have matched a literal path of that name and nothing else. -->
    <url-pattern>/favicon.ico</url-pattern>
    <!-- For Letsencrypt.org -->
    <url-pattern>/.well-known/acme-challenge/*</url-pattern>
    <!-- For BingBot Webmaster -->
    <url-pattern>/BingSiteAuth.xml</url-pattern>
    <!-- Use the web server -->
    <url-pattern>/css/*</url-pattern>
    <url-pattern>/fonts/*</url-pattern>
    <url-pattern>/html/*</url-pattern>
    <url-pattern>/images/*</url-pattern>
    <url-pattern>/javascript/*</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>RobotsServlet</servlet-name>
    <url-pattern>/robots.txt</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>PageServlet</servlet-name>
    <url-pattern>/</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>RestServlet</servlet-name>
    <url-pattern>/api</url-pattern>
    <url-pattern>/api/*</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>MediaApi</servlet-name>
    <url-pattern>/visual-editor/media</url-pattern>
    <url-pattern>/visual-editor/media/*</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>StylesheetServlet</servlet-name>
    <url-pattern>/css/custom/*</url-pattern>
  </servlet-mapping>
  <!-- Sessions -->
  <session-config>
    <session-timeout>60</session-timeout>
    <tracking-mode>COOKIE</tracking-mode>
  </session-config>
  <!-- Per the JSP spec, a .jsp file with no pageEncoding/contentType directive of its own is read
       as ISO-8859-1 at compile time, independent of the JVM's own file.encoding default (JEP 400
       does not apply here; this is Jasper's own JSP-spec-mandated fallback). Only 3 of ~354 JSPs in
       this project declare pageEncoding explicitly, so any other JSP with a literal non-ASCII
       character in its static template text (an em dash, a curly quote, etc.) gets that character
       silently corrupted into mojibake at compile time, reproducibly, since the wrong bytes are
       baked into the compiled class, not mis-served at runtime. This default applies UTF-8 to every
       JSP so newly-written pages don't need their own pageEncoding directive to render correctly. -->
  <jsp-config>
    <jsp-property-group>
      <url-pattern>*.jsp</url-pattern>
      <page-encoding>UTF-8</page-encoding>
    </jsp-property-group>
  </jsp-config>
  <!-- Errors -->
  <error-page>
    <error-code>401</error-code>
    <location>/WEB-INF/jsp/error-401.jsp</location>
  </error-page>
  <error-page>
    <error-code>403</error-code>
    <location>/WEB-INF/jsp/error-403.jsp</location>
  </error-page>
  <error-page>
    <error-code>404</error-code>
    <location>/WEB-INF/jsp/error-404.jsp</location>
  </error-page>
  <error-page>
    <location>/WEB-INF/jsp/error-500.jsp</location>
  </error-page>
  <!-- Constraints -->
  <security-constraint>
    <web-resource-collection>
      <web-resource-name>allowed methods</web-resource-name>
      <url-pattern>/*</url-pattern>
      <http-method-omission>HEAD</http-method-omission>
      <http-method-omission>GET</http-method-omission>
      <http-method-omission>POST</http-method-omission>
    </web-resource-collection>
    <auth-constraint/>
  </security-constraint>
  <security-constraint>
    <web-resource-collection>
      <web-resource-name>allowed methods</web-resource-name>
      <url-pattern>/api/*</url-pattern>
      <http-method-omission>GET</http-method-omission>
      <http-method-omission>POST</http-method-omission>
      <http-method-omission>PUT</http-method-omission>
      <http-method-omission>PATCH</http-method-omission>
      <http-method-omission>DELETE</http-method-omission>
    </web-resource-collection>
    <auth-constraint/>
  </security-constraint>
</web-app>