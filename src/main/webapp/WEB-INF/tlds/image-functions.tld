<taglib xmlns="https://jakarta.ee/xml/ns/jakartaee"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-jsptaglibrary_3_0.xsd"
        version="3.0">
    <tlib-version>1.0</tlib-version>
    <short-name>image</short-name>
    <function>
        <description>
            Returns a ready-to-use srcset attribute value for an image's existing generated variants,
            or "" if none exist yet
        </description>
        <name>srcset</name>
        <function-class>com.simisinc.platform.application.cms.ImageCommand</function-class>
        <function-signature>java.lang.String srcset(java.lang.String)</function-signature>
    </function>
    <function>
        <description>
            Same as srcset, but against a caller-supplied imageId-to-variants map (no DB call) --
            for use in a JSP loop rendering many images on one page
        </description>
        <name>srcsetBatch</name>
        <function-class>com.simisinc.platform.application.cms.ImageCommand</function-class>
        <function-signature>java.lang.String srcsetBatch(java.lang.String,java.util.Map)</function-signature>
    </function>
</taglib>
