<%-- Navigation --%>
<div>
  <div id="platform-menu">
    <div class="top-bar checkout-bar">
      <div class="grid-container">
        <div class="grid-x grid-margin-x">
          <div class="small-12 text-center cell">
            <c:choose>
              <c:when test="${!empty sitePropertyMap['site.logo']}">
                <c:set var="logoSrcset" value="${image:srcset(sitePropertyMap['site.logo'])}"/>
                <div class="top-logo"><a href="${ctx}/cart"><img src="<c:out value="${sitePropertyMap['site.logo']}"/>"
                  <c:if test="${not empty logoSrcset}"> srcset="<c:out value="${logoSrcset}"/>" sizes="200px"</c:if>
                  decoding="async"/></a></div>
              </c:when>
              <c:otherwise>
                <div class="top-logo"><a href="${ctx}/cart"><img id="logo-header-checkout" src="${ctx}/images/logo-header.png" loading="eager"/></a></div>
                <%-- Defaults to the bundled logo; upgrades to the admin-configured one only once an
                     Image() probe confirms it actually loads, so a fresh install never 404s here. --%>
                <c:if test="${!empty brandedAssetContext}">
                  <script nonce="${cspNonce}">(function(){var u='${js:escape(brandedAssetContext)}/images/logo-header.png';var i=new Image();i.onload=function(){document.getElementById('logo-header-checkout').src=u;};i.src=u;})();</script>
                </c:if>
              </c:otherwise>
            </c:choose>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
