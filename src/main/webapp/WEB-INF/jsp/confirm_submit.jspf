<%--
  Asks for confirmation before an action proceeds:
    - any form carrying data-confirm-submit="<message>"
    - any link carrying data-confirm-href="<message>"

  These were written as inline confirm() handler attributes (issue #1188). PageServlet sends
  script-src 'self' 'nonce-<random>' with no 'unsafe-inline', and inline event handler attributes
  fall under script-src-attr, which a nonce does not authorise -- the nonce covers a <script>
  block, not an attribute that calls into one.

  The dangerous part is that a blocked handler is skipped rather than treated as a cancel, so the
  browser goes ahead: the form submits, or the link navigates to its href. Both element types
  guarded destructive or publishing actions, so the failure mode was an irreversible operation
  running with no prompt at all -- not a dead control.

  Delegated from document rather than bound per element so that one listener covers markup
  rendered inside a <c:forEach>, and registered on the capture phase so the prompt cannot be
  bypassed by a handler that stops propagation. The click path uses closest() because these links
  usually wrap an <i> icon, which is what the event actually targets. The window flag keeps a page
  that pulls this in from two different widgets down to a single dialog.
  --%>
<script nonce="${cspNonce}">
  if (!window.platformConfirmSubmitBound) {
    window.platformConfirmSubmitBound = true;
    document.addEventListener('submit', function (event) {
      var form = event.target;
      if (!form || typeof form.getAttribute !== 'function') {
        return;
      }
      var message = form.getAttribute('data-confirm-submit');
      if (message && !window.confirm(message)) {
        event.preventDefault();
      }
    }, true);
    document.addEventListener('click', function (event) {
      var target = event.target;
      if (!target || typeof target.closest !== 'function') {
        return;
      }
      var link = target.closest('[data-confirm-href]');
      if (link && !window.confirm(link.getAttribute('data-confirm-href'))) {
        event.preventDefault();
      }
    }, true);
  }
</script>
